NODE_ENV=development
PORT=3000
DB_FILE=./data/summit-base.sqlite

# ADMIN_EMAIL + ADMIN_PASSWORD membentuk 1 akun DEFAULT ADMIN.
# Hanya akun DEFAULT ADMIN yang dapat membuat akun admin lain.
# Wajib diganti saat production
ADMIN_EMAIL=admin@summitbase.local
ADMIN_PASSWORD=Admin!ChangeMe123
ADMIN_NAME=Summit Base Admin
SESSION_TTL_DAYS=7

# Cookie aman otomatis aktif saat NODE_ENV=production
COOKIE_SECURE=false
