[Unit]
Description=Summit Base Node.js application
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=summit
Group=summit
WorkingDirectory=/var/www/summit-base
EnvironmentFile=/var/www/summit-base/.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/summit-base/data

[Install]
WantedBy=multi-user.target
